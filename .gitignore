/models/
/results/
*.pt
*.npz

# ── Contextual-vector pipeline artifacts (Stage 0/A/B outputs) ────────────
# Everything generated by experiments/contextual/ lands under artifacts/.
/artifacts/

# ── Figures: keep, they're small and used in the paper ────────────────────
# (figures/ is intentionally NOT ignored)

/.claude
